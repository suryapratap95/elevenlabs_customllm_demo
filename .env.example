# Copy to .env (never commit .env)

# Azure AI Foundry / Azure OpenAI (used by YOUR server; ElevenLabs never sees these)
# Endpoint is the resource URL, e.g. https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Deployment name in Foundry (must match what you deployed; often same as the model id)
AZURE_OPENAI_DEPLOYMENT=gpt-6-sol

# Shared secret: put the SAME value in ElevenLabs → Custom LLM → API key (create a new secret)
DEMO_LLM_SECRET=change-me-to-a-long-random-string

# From ElevenLabs → your agent → Widget / embed code
ELEVENLABS_AGENT_ID=

# Optional: MS Teams Workflows webhook (receives case reference + status only)
TEAMS_WEBHOOK_URL=
